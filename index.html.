function money(number){

    return "£"+
        Math.round(number)
        .toLocaleString("en-GB");

}


function dateString(){

    return new Date(
        game.year,
        game.month-1
    ).toLocaleString(
        "en-GB",
        {
            month:"long",
            year:"numeric"
        }
    );

}


function carValue(){

    return game.cars.reduce(
        (total,item)=>
            total+item.price,
        0
    );

}


function propertyValue(){

    return game.properties.reduce(
        (total,item)=>
            total+item.price,
        0
    );

}


function businessValue(){

    return game.companies.reduce(
        (total,item)=>
            total+item.value,
        0
    );

}


function investmentValue(){

    return Object.values(
        game.investments
    ).reduce(
        (total,item)=>
            total+item,
        0
    );

}


function netWorth(){

    return game.cash+
        carValue()+
        propertyValue()+
        businessValue()+
        investmentValue()-
        game.debt;

}


