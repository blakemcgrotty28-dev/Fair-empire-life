    game.cash-=amount;

    game.investments[i]=
        (game.investments[i]||0)+amount;

    buySound();

    addNews(
        "📈 You invested "+
        money(amount)+
        " into "+
        investments[i][0]+".",
        false
    );

    showToast("📈 Investment made!");

    render();

}


function sellInvest(i){

    const owned=
        game.investments[i]||0;

    if(!owned) return;

    const amount=
        Number(
            prompt(
                "You own "+
                money(owned)+
                ". How much do you want to sell?"
            )
        );

    if(!amount||amount<=0||amount>owned)
        return;

    game.investments[i]-=amount;

    game.cash+=amount;

    sellSound();

    showToast(
        "💵 Sold "+money(amount)
    );

    render();

}



/* =====================================================
   LIFE & EDUCATION
===================================================== */

function currentAge(){
    return Math.max(10, game.year-game.birthYear);
}

function ageStage(){
    const a=currentAge();
    if(a<16) return "School";
    if(a<18) return "College / Sixth Form / Apprenticeship";
    if(a<21) return "Further Education / Early Career";
    return "Adult Life";
}

function chooseSchool(type,cost,skill,happy){
    if(currentAge()>15){
        showToast("🏫 School choice is finished.");
        return;
    }
    if(game.school){
        showToast("🏫 You have already chosen a school.");
        return;
    }

    let actualCost=cost;

    /* State school is always free. If the player cannot afford a paid school,
       automatically give them a scholarship application instead of blocking them. */
    if(cost>0 && game.cash<cost){
        const scholarshipChance = type==="Academy" ? 0.85 : 0.65;
        if(Math.random() <= scholarshipChance){
            actualCost=0;
            game.news.unshift({
               text:"🎓 Scholarship awarded! You can attend "+type+" without paying the normal fees.",
               good:true,
               year:game.year,
               month:game.month
            });
            showToast("🎓 Scholarship awarded — your school is covered!");
        }else{
            showToast("💷 You don't have enough money, but you can choose the free Local State School.");
            return;
        }
    }

    game.cash-=actualCost;
    game.school=type;
    game.skills+=skill;
    game.happiness=Math.max(0,Math.min(100,game.happiness+happy));
    addNews("🏫 You chose "+type+" for your school.",false);
    saveSilent();
    render();
}

function chooseEducation(path,cost,skill,qualification){
    const a=currentAge();
    if(a<16){
        showToast("📚 Finish school first.");
        return;
    }
    if(game.educationLevel>=2 && game.education===path){
        showToast("🎓 You are already on this route.");
        return;
    }
    if(game.cash<cost){
        showToast("❌ You need "+money(cost)+".");
        return;
    }
    game.cash-=cost;
    game.education=path;
    game.educationLevel=Math.max(game.educationLevel, path==="University"?3:path==="College / Sixth Form"?2:1);
    game.skills+=skill;
    game.qualification=qualification;
    game.happiness=Math.max(0,Math.min(100,game.happiness+4));
    addNews("🎓 Education choice: "+path+".",false);
    saveSilent();
    render();
}

