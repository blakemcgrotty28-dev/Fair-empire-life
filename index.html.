function playMusicNote(freq,duration=.7){

    if(!musicEnabled) return;

    if(!initAudio()) return;

    const osc=
        audioContext.createOscillator();

    const gain=
        audioContext.createGain();

    const now=
        audioContext.currentTime;

    osc.type="sine";

    osc.frequency.value=freq;

    gain.gain.setValueAtTime(
        0,
        now
    );

    gain.gain.linearRampToValueAtTime(
        musicVolume*.09,
        now+.08
    );

    gain.gain.exponentialRampToValueAtTime(
        .001,
        now+duration
    );

    osc.connect(gain);
    gain.connect(audioContext.destination);

    osc.start(now);
    osc.stop(now+duration);

}


function startMusic(){

    if(musicTimer) return;

    musicEnabled=true;

    musicIndex=0;

    musicTimer=setInterval(()=>{

        playMusicNote(
            menuMelody[musicIndex],
            .62
        );

        musicIndex++;

        if(
            musicIndex>=
            menuMelody.length
        ){
            musicIndex=0;
        }

    },700);

}


function stopMusic(){

    if(musicTimer){

        clearInterval(musicTimer);

        musicTimer=null;

    }

}


