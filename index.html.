<script>

/* =====================================================
   GAME DATA
===================================================== */

let game={
    year:2026,
    month:1,
    birthYear:2016,
    age:10,
    cash:0,
    job:"Unemployed",
    salary:0,
    career:null,
    level:0,
    experience:0,
    performance:70,
    debt:0,
    cars:[],
    properties:[],
    companies:[],
    investments:{},
    news:[],
    school:"",
    education:"School",
    educationLevel:0,
    qualification:"",
    skills:0,
    happiness:75,
    stress:10,
    workAction:false,
    educationAction:false
};


/* =====================================================
   AUDIO
===================================================== */

let soundEnabled=true;
let musicEnabled=false;
let effectsVolume=.70;
let musicVolume=.25;

let audioContext=null;
let musicTimer=null;
let musicIndex=0;


/* =====================================================
   AUDIO INITIALISATION
===================================================== */

function initAudio(){

    if(!audioContext){

        const AudioContext=
            window.AudioContext||
            window.webkitAudioContext;

        if(!AudioContext){
            return false;
        }

        audioContext=new AudioContext();

    }

    if(audioContext.state==="suspended"){
        audioContext.resume();
    }

    return true;
}


/* =====================================================
   SOUND EFFECTS
===================================================== */

function tone(freq,duration=.12,type="sine",volume=.2,delay=0){

    if(!soundEnabled) return;

    if(!initAudio()) return;

    const osc=
        audioContext.createOscillator();

    const gain=
        audioContext.createGain();

    const start=
        audioContext.currentTime+delay;

    const end=start+duration;

    osc.type=type;

    osc.frequency.setValueAtTime(
        freq,
        start
    );

    gain.gain.setValueAtTime(
        0,
        start
    );

    gain.gain.linearRampToValueAtTime(
        volume*effectsVolume,
        start+.015
    );

    gain.gain.exponentialRampToValueAtTime(
        .001,
        end
    );

    osc.connect(gain);
    gain.connect(audioContext.destination);

    osc.start(start);
    osc.stop(end);
}


