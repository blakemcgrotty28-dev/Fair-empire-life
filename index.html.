function advanceMonth(){

    clickSound();

    const a=currentAge();

    /* Education / childhood does not require a job */
    if(a<18){
        game.stress=Math.max(0,game.stress-1);
        if(!game.educationAction) game.skills+=1;
        game.educationAction=false;
game.companies=(game.companies||[]).map(c=>({
    ...c,
    totalInvested:c.totalInvested??c.price??0,
    totalDividends:c.totalDividends??0,
    expansions:c.expansions??0,
    costCuts:c.costCuts??0
}));
        if(game.school) game.skills+=1;
        if(Math.random()<.15){
            game.happiness=Math.max(0,Math.min(100,game.happiness+(Math.random()>.5?4:-4)));
            addNews(Math.random()>.5 ? "📚 You had a great month at school." : "⚠️ School was difficult this month.");
        }
    } else if(!game.career){
        badNewsSound();
        showToast("⚠️ Choose a career first.");
        show("career");
        return;
    } else {
        game.experience++;
        if(!game.workAction){
            game.performance=Math.max(20,game.performance-1);
        }
        game.workAction=false;

    const monthly=(currentAge()>=18 && game.career)?game.salary/12:0;
    const tax=monthly*.20;
    const living=currentAge()>=18?1200:0;
    const takeHome=monthly-tax-living;

    game.cash+=takeHome;

    if(takeHome>0) moneySound();

    game.properties.forEach(
        p=>game.cash+=p.rent
    );

    let businessProfit=0;

    game.companies.forEach(c=>{

        const old=c.profit;

        const change=.85+Math.random()*.30;

        const profit=old*change;

        businessProfit+=profit;

        game.cash+=profit;

        c.value*=
            1+(Math.random()*.06-.02);

        if(profit<old*.9)
            c.health=Math.max(10,c.health-2);

        else if(profit>old*1.05)
            c.health=Math.min(100,c.health+1);

    });

    if(businessProfit>0)
        profitSound();

    let investmentChange=0;

    Object.keys(game.investments)
    .forEach(i=>{

        const old=game.investments[i];

        const rate=investments[i][1]/12;

        const random=(Math.random()-.5)*.04;

        game.investments[i]*=
            1+rate+random;

        investmentChange+=
            game.investments[i]-old;

    });

    if(investmentChange>50)
        profitSound();

    if(investmentChange<-50)
        lossSound();


    const career=careers[game.career];

    const next=career.levels[game.level+1];

    if(
        next &&
        game.experience>=next[2] &&
        game.performance>=75 &&
        currentAge()>=18
    ){

        game.level++;

        game.job=next[0];
        game.salary=next[1];
        game.performance=75;

        promotionSound();

        addNews(
            "🎉 PROMOTION! You are now "+
            game.job+
            " earning "+
            money(game.salary)+
            " per year.",
            false
        );

        showToast("🎉 PROMOTION!");

    }else{

        const change=
            Math.random()>.65
            ?2
            :Math.random()<.25
            ?-3
            :0;

        game.performance=
            Math.max(
                20,
                Math.min(
                    100,
                    game.performance+change
                )
            );

    }

    }

    if(a>=18 && game.career){
        game.stress=Math.max(0,game.stress-1);
    }

    randomEvent();

    game.month++;

    if(game.month>12){

        game.month=1;
        game.year++;

        achievementSound();

        addNews(
            "🎉 A new year has begun: "+
            game.year,
            false
        );

    }

    saveSilent();

    render();

}


