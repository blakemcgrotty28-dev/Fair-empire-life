<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#05080d">
<title>Empire Life V1.0</title>

<style>
*{box-sizing:border-box}

html,body{
    margin:0;
    width:100%;
    min-height:100%;
    background:#05080d;
    color:#fff;
    font-family:Arial,sans-serif;
}

body{
    padding-bottom:82px;
}

.app{
    max-width:700px;
    margin:auto;
}

/* =====================================================
   MAIN MENU
===================================================== */

#mainMenu{
    position:fixed;
    inset:0;
    z-index:1000;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle at 50% 35%,rgba(38,100,170,.28),transparent 35%),
        linear-gradient(180deg,#071321 0%,#030509 100%);
}

#mainMenu::before,
#mainMenu::after{
    content:"";
    position:absolute;
    border-radius:50%;
    pointer-events:none;
}

#mainMenu::before{
    width:420px;
    height:420px;
    background:radial-gradient(circle,rgba(47,129,226,.20),transparent 68%);
    animation:planetGlow 5s ease-in-out infinite;
}

#mainMenu::after{
    width:2px;
    height:2px;
    background:#fff;
    box-shadow:
        20px 30px #fff,
        70px 120px #fff,
        120px 45px #aaa,
        180px 180px #fff,
        230px 75px #aaa,
        290px 140px #fff,
        340px 30px #fff,
        390px 210px #aaa,
        -30px 180px #fff,
        -90px 70px #aaa,
        -150px 230px #fff,
        -200px 120px #aaa,
        -250px 30px #fff,
        -300px 190px #fff,
        10px -120px #aaa,
        150px -80px #fff,
        -180px -100px #fff;
    opacity:.65;
    animation:stars 8s linear infinite;
}

.menu-content{
    position:relative;
    z-index:3;
    width:92%;
    max-width:500px;
    text-align:center;
    padding:25px;
}

.earth{
    width:170px;
    height:170px;
    margin:0 auto 22px;
    border-radius:50%;
    background:
        radial-gradient(circle at 35% 30%,#5fb7ff 0%,#1768b0 30%,#0a315b 65%,#020914 100%);
    box-shadow:
        0 0 35px rgba(48,145,255,.5),
        0 0 90px rgba(48,145,255,.18);
    position:relative;
    animation:earthFloat 5s ease-in-out infinite;
}

.earth::before{
    content:"";
    position:absolute;
    width:75px;
    height:42px;
    left:35px;
    top:38px;
    border-radius:55% 35% 45% 60%;
    background:#4c9b57;
    transform:rotate(-15deg);
    opacity:.9;
}

.earth::after{
    content:"";
    position:absolute;
    width:60px;
    height:35px;
    right:24px;
    bottom:32px;
    border-radius:45% 60% 35% 50%;
    background:#4b9854;
    transform:rotate(20deg);
}

.menu-title{
    font-size:48px;
    font-weight:900;
    letter-spacing:3px;
    text-shadow:0 0 25px rgba(72,160,255,.55);
    margin:0;
}

.menu-subtitle{
    color:#9eafc2;
    font-size:16px;
    margin:8px 0 35px;
}

.ready{
    font-size:25px;
    font-weight:bold;
    margin-bottom:18px;
    animation:readyPulse 2.5s ease-in-out infinite;
}

.menu-button{
    display:block;
    width:100%;
    max-width:350px;
    margin:10px auto;
    padding:16px;
    border:1px solid rgba(90,157,226,.45);
    border-radius:15px;
    color:white;
    background:rgba(28,54,80,.75);
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    transition:.2s;
}

.menu-button:hover{
    background:rgba(43,91,135,.9);
    transform:translateY(-2px);
}

.menu-button.start{
    background:linear-gradient(135deg,#287fe5,#1755a0);
    border-color:#4a9bff;
    box-shadow:0 0 25px rgba(42,127,229,.25);
}

.menu-button:active{
    transform:scale(.97);
}

.menu-version{
    margin-top:25px;
    font-size:11px;
    color:#5c6b7b;
}

/* =====================================================
   INTRO
===================================================== */

#introScreen{
    position:fixed;
    inset:0;
    z-index:900;
    display:none;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
        radial-gradient(circle at 50% 45%,#173d63 0%,#081321 42%,#030509 100%);
}

.intro-content{
    width:90%;
    max-width:500px;
    animation:introIn 1.2s ease;
}

.intro-small{
    color:#8fa8c0;
    letter-spacing:3px;
    text-transform:uppercase;
    font-size:12px;
}

.intro-title{
    font-size:42px;
    margin:18px 0;
}

.intro-text{
    line-height:1.8;
    color:#c4d0dc;
    font-size:16px;
}

.intro-money{
    font-size:42px;
    font-weight:bold;
    margin:25px 0;
}

.intro-button{
    border:0;
    padding:16px 35px;
    border-radius:14px;
    background:#287fe5;
    color:#fff;
    font-weight:bold;
    font-size:16px;
}

/* =====================================================
   GAME UI
===================================================== */

.header{
    background:#151d27;
    padding:16px;
    position:sticky;
    top:0;
    z-index:20;
    border-bottom:1px solid #293543;
}

.header h1{
    margin:0;
    font-size:22px;
}

.date{
    font-size:13px;
    color:#8996a5;
    margin-top:5px;
}

.screen{
    display:none;
    padding:14px;
}

.screen.active{
    display:block;
}

.card{
    background:#18222d;
    border-radius:16px;
    padding:16px;
    margin-bottom:12px;
}

.hero{
    background:linear-gradient(135deg,#193b63,#18232f);
}

.money{
    font-size:30px;
    font-weight:bold;
}

.label{
    font-size:12px;
    color:#8996a5;
}

.small{
    font-size:13px;
    color:#8996a5;
}

.row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:9px 0;
}

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.stat{
    background:#202c38;
    padding:13px;
    border-radius:12px;
}

button{
    width:100%;
    border:0;
    border-radius:12px;
    padding:13px;
    margin-top:8px;
    font-size:15px;
    font-weight:bold;
    color:white;
    background:#2875e5;
    cursor:pointer;
}

button:active{
    transform:scale(.97);
}

button.green{background:#267a4c}
button.red{background:#8d3434}
button.dark{background:#293744}
button.gold{background:#856b20}

.market-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.market-card{
    background:#19242f;
    border-radius:16px;
    overflow:hidden;
    border:1px solid #293746;
}

.market-image{
    width:100%;
    height:145px;
    object-fit:cover;
    display:block;
    background:#263442;
}

.market-body{
    padding:13px;
}

.market-title{
    font-size:17px;
    font-weight:bold;
    margin-bottom:6px;
}

.price{
    font-size:20px;
    font-weight:bold;
}

.badge{
    display:inline-block;
    background:#293a4b;
    border-radius:20px;
    padding:5px 8px;
    font-size:11px;
    margin-top:5px;
}

.good{color:#54df8b}
.bad{color:#ff6666}
.warning{color:#ffd45c}

.news{
    background:#19242f;
    border-left:4px solid #367de8;
    padding:13px;
    border-radius:9px;
    margin-bottom:10px;
}

.bottom-nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    height:72px;
    background:#151d27;
    border-top:1px solid #293543;
    display:flex;
    z-index:100;
}

.nav{
    flex:1;
    background:none;
    padding:5px 2px;
    margin:0;
    font-size:10px;
    border-radius:0;
}

.nav-icon{
    display:block;
    font-size:20px;
    margin-bottom:3px;
}

.nav.active{
    background:#202d3a;
}

input[type="range"]{
    width:100%;
}

.setting-row{
    background:#202c38;
    padding:13px;
    border-radius:12px;
    margin-bottom:10px;
}

.setting-row label{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.progress{
    height:9px;
    background:#0d131a;
    border-radius:10px;
    overflow:hidden;
}

.progress-bar{
    height:100%;
    background:#347fe8;
}

.toast{
    position:fixed;
    left:50%;
    bottom:88px;
    transform:translateX(-50%) translateY(20px);
    background:#202d3a;
    border:1px solid #3a4b5d;
    border-radius:12px;
    padding:12px 18px;
    opacity:0;
    pointer-events:none;
    transition:.25s;
    z-index:1200;
    max-width:90%;
    text-align:center;
}

.toast.show{
    opacity:1;
    transform:translateX(-50%) translateY(0);
}
.life-choice{
    border:1px solid #30475b;
    background:#1b2935;
    border-radius:14px;
    padding:14px;
    margin:9px 0;
}
.life-choice h3{margin:0 0 6px}
.life-choice p{margin:5px 0;color:#9aaaba;font-size:13px}
.stat-bar{
    height:10px;background:#0d131a;border-radius:10px;overflow:hidden;margin-top:6px;
}
.stat-fill{height:100%;background:#347fe8}
.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.action-grid button{margin-top:0}
.tag{
    display:inline-block;padding:4px 8px;border-radius:12px;
    background:#293a4b;font-size:11px;margin:3px 3px 0 0;
}
.nav-wrap{
    position:fixed;bottom:0;left:0;right:0;height:72px;
    background:#151d27;border-top:1px solid #293543;z-index:100;
    overflow-x:auto;overflow-y:hidden;
}
.nav-wrap .bottom-nav{position:static;width:max-content;min-width:100%;height:72px}
.nav-wrap .nav{min-width:78px}
.business-controls{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:10px}
.business-controls button{margin-top:0;font-size:12px}
.business-panel{background:#101820;border:1px solid #2a3a48;border-radius:12px;padding:10px;margin-top:8px}

@media(max-width:430px){
    .action-grid{grid-template-columns:1fr}
}


@keyframes earthFloat{
    0%,100%{transform:translateY(0) rotate(0deg)}
    50%{transform:translateY(-10px) rotate(3deg)}
}

@keyframes planetGlow{
    0%,100%{transform:scale(.9);opacity:.6}
    50%{transform:scale(1.15);opacity:1}
}

@keyframes stars{
    from{transform:translateY(0)}
    to{transform:translateY(25px)}
}

@keyframes readyPulse{
    0%,100%{opacity:.75}
    50%{opacity:1}
}

@keyframes introIn{
    from{opacity:0;transform:translateY(25px)}
    to{opacity:1;transform:translateY(0)}
}

@media(max-width:430px){

    .menu-title{
        font-size:39px;
    }

    .earth{
        width:145px;
        height:145px;
    }

    .market-grid{
        gap:8px;
    }

    .market-image{
        height:120px;
    }

    .market-body{
        padding:10px;
    }

}
</style>
</head>

<body>

<!-- =====================================================
     MAIN MENU
===================================================== -->

<div id="mainMenu">

    <div class="menu-content">

        <div class="earth"></div>

        <h1 class="menu-title">
            EMPIRE LIFE
        </h1>

        
<div class="menu-subtitle">
