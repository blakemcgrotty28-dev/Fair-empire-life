/* =====================================================
   TOAST
===================================================== */

let toastTimer=null;

function showToast(message){

    const t=
        document.getElementById("toast");

    t.textContent=message;

    t.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer=setTimeout(
        ()=>t.classList.remove("show"),
        2200
    );

}


/* =====================================================
   RENDER
===================================================== */


function renderBusinessManagement(){
    const el=document.getElementById("businessManagement");
    if(!el) return;

    game.companies=game.companies||[];

    game.companies.forEach(c=>{
        c.health=c.health??75;
        c.invested=c.invested??Number(c.value||0);
        c.dividends=c.dividends??0;
        c.profit=c.profit??0;
        c.value=c.value??0;
    });

    if(!game.companies.length){
        el.innerHTML=`<div class="life-choice">
            <h3>🏢 No businesses yet</h3>
            <p>Buy a company from the Market and it will appear here.</p>
            <button onclick="show('market')">🛒 Find a Business</button>
        </div>`;
        return;
    }

    el.innerHTML=game.companies.map((c,i)=>`
        <div class="life-choice">
            <h3>🏢 ${c.name||"Business"}</h3>
            <div class="row"><span>Company value</span><b>${money(c.value)}</b></div>
            <div class="row"><span>Monthly profit</span><b>${money(c.profit)}</b></div>
            <div class="row"><span>Company health</span><b>${Math.round(c.health)}%</b></div>
            <div class="row"><span>Total invested</span><b>${money(c.invested)}</b></div>
            <div class="row"><span>Dividends taken</span><b>${money(c.dividends)}</b></div>
            <div class="action-grid">
                <button onclick="businessInvest(${i})">📈 Invest</button>
                <button onclick="businessDividend(${i})">💷 Take Profit</button>
                <button onclick="businessExpand(${i})">🚀 Expand</button>
                <button onclick="businessCutCosts(${i})">✂️ Cut Costs</button>
                <button onclick="businessSell(${i})">💰 Sell Company</button>
            </div>
        </div>`).join("");
}

function businessInvest(i){
    const c=game.companies[i]; if(!c)return;
    const amount=Number(prompt("How much would you like to invest?","1000"));
    if(!Number.isFinite(amount)||amount<=0)return;
    if(game.cash<amount){showToast("❌ You don't have enough cash.");return;}
    game.cash-=amount;
    c.invested+=amount;
    c.value+=amount*1.05;
    c.profit+=amount*0.01;
    c.health=Math.min(100,c.health+2);
    addNews("📈 You invested "+money(amount)+" into "+c.name+".",true);
    moneySound(); saveSilent(); render();
}

function businessDividend(i){
    const c=game.companies[i]; if(!c)return;
    const amount=Math.floor(Math.max(0,c.profit*3));
    if(amount<1){showToast("⚠️ Not enough profit available yet.");return;}
    game.cash+=amount;
    c.dividends+=amount;
    c.value=Math.max(0,c.value-amount*0.25);
    c.health=Math.max(0,c.health-1);
    addNews("💷 You took "+money(amount)+" in profit from "+c.name+".",true);
    moneySound(); saveSilent(); render();
}

function businessExpand(i){
    const c=game.companies[i]; if(!c)return;
    const cost=Math.max(1000,Math.round(c.value*0.10));
    if(game.cash<cost){showToast("❌ Expansion costs "+money(cost)+".");return;}
    game.cash-=cost;
    c.invested+=cost;
    c.value+=cost*1.35;
    c.profit+=cost*0.025;
    c.health=Math.min(100,c.health+4);
    addNews("🚀 You expanded "+c.name+" for "+money(cost)+".",true);
    moneySound(); saveSilent(); render();
}

function businessCutCosts(i){
    const c=game.companies[i]; if(!c)return;
    c.profit=Math.max(0,c.profit*1.12);
    c.health=Math.max(0,c.health-7);
    addNews("✂️ You cut costs at "+c.name+". Profit increased, but health fell.",false);
    saveSilent(); render();
}

function businessSell(i){
    const c=game.companies[i]; if(!c)return;
    const value=Math.max(0,Number(c.value||0));
    if(!confirm("Sell "+c.name+" for "+money(value)+"?"))return;
    game.cash+=value;
    game.companies.splice(i,1);
    addNews("💰 You sold "+c.name+" for "+money(value)+".",true);
    moneySound(); saveSilent(); render();
}

function render(){
    renderBusinessManagement();

    document
        .getElementById("date")
        .textContent=dateString();

    document
        .getElementById("cash")
        .textContent=money(game.cash);

    document
        .getElementById("networth")
        .textContent=money(netWorth());

    document
        .getElementById("job")
        .textContent=game.job;

    document
        .getElementById("salary")
        .textContent=money(game.salary);

    const homeAge=document.getElementById("homeAge");
    const homeSkills=document.getElementById("homeSkills");
    if(homeAge) homeAge.textContent=currentAge();
    if(homeSkills) homeSkills.textContent=game.skills;

    document
        .getElementById("debt")
        .textContent=money(game.debt);

    document
        .getElementById("carCount")
        .textContent=game.cars.length;

    document
        .getElementById("propertyCount")
        .textContent=game.properties.length;

    renderLife();
    renderWork();
    renderCareer();
    renderJobs();
    renderOwned();
    renderNews();

}


