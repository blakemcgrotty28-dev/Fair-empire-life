function investInCompany(i){
    const c=game.companies[i];
    const max=Math.max(0,Math.floor(game.cash));
    if(max<1000){
        lossSound();
        showToast("❌ You need at least £1,000 to invest.");
        return;
    }
    let raw=prompt(
        "📈 Invest in "+c.name+"\n\n"+
        "Cash available: "+money(max)+"\n"+
        "Enter the amount to invest:"
    );
    if(raw===null) return;
    const amount=Math.floor(Number(String(raw).replace(/[^0-9.]/g,"")));
    if(!Number.isFinite(amount)||amount<1000||amount>game.cash){
        lossSound();
        showToast("❌ Enter a valid amount between £1,000 and your cash.");
        return;
    }
    game.cash-=amount;
    c.value+=amount;
    c.profit+=amount*.0008;
    c.health=Math.min(100,c.health+Math.min(15,amount/10000*3));
    c.totalInvested=(c.totalInvested||0)+amount;
    profitSound();
    addNews("📈 You invested "+money(amount)+" into "+c.name+".",false);
    showToast("📈 Investment made!");
    render();
}

function takeCompanyDividend(i){
    const c=game.companies[i];
    const dividend=Math.max(0,Math.floor(c.profit*.25));
    if(dividend<=0){
        showToast("❌ This company has no available profit.");
        return;
    }
    game.cash+=dividend;
    c.value=Math.max(c.price||0,c.value-dividend*.35);
    c.profit=Math.max(100,c.profit-dividend*.08);
    c.totalDividends=(c.totalDividends||0)+dividend;
    moneySound();
    addNews("💷 You took a "+money(dividend)+" dividend from "+c.name+".",false);
    showToast("💷 Dividend paid to you!");
    render();
}

function expandCompany(i){
    const c=game.companies[i];
    const cost=Math.max(5000,Math.floor(c.value*.05));
    if(game.cash<cost){
        lossSound();
        showToast("❌ Expansion costs "+money(cost)+".");
        return;
    }
    game.cash-=cost;
    c.value+=cost*1.35;
    c.profit*=1.12;
    c.health=Math.min(100,c.health+8);
    c.expansions=(c.expansions||0)+1;
    achievementSound();
    addNews("🚀 You expanded "+c.name+" for "+money(cost)+". Profit is now "+money(c.profit)+"/month.",false);
    showToast("🚀 Business expanded!");
    render();
}

function cutCompanyCosts(i){
    const c=game.companies[i];
    c.profit=Math.max(100, c.profit*1.06);
    c.health=Math.max(20,c.health-4);
    c.costCuts=(c.costCuts||0)+1;
    moneySound();
    addNews("✂️ You cut operating costs at "+c.name+". Monthly profit improved, but health fell slightly.",false);
    showToast("✂️ Costs reduced.");
    render();
}

/* =====================================================
   COMPANY MANAGEMENT
===================================================== */

function manageCompany(i){

    const c=game.companies[i];

    const choice=prompt(
        "🏢 "+c.name+" BUSINESS DASHBOARD\n\n"+
        "Value: "+money(c.value)+"\n"+
        "Profit: "+money(c.profit)+"/month\n"+
        "Health: "+Math.round(c.health)+"%\n"+
        "Total invested: "+money(c.totalInvested||0)+"\n"+
        "Dividends taken: "+money(c.totalDividends||0)+"\n\n"+
        "1 = Invest a custom amount\n"+
        "2 = Take 25% profit as dividend\n"+
        "3 = Expand business\n"+
        "4 = Cut costs\n"+
        "5 = Sell company\n"+
        "6 = Cancel"
    );

    if(choice==="1") investInCompany(i);
    else if(choice==="2") takeCompanyDividend(i);
    else if(choice==="3") expandCompany(i);
    else if(choice==="4") cutCompanyCosts(i);
    else if(choice==="5") sellCompany(i);
}


/* =====================================================
   BANK
===================================================== */

function loan(amount){

    game.cash+=amount;
    game.debt+=amount;

    loanSound();

    addNews(
        "🏦 You borrowed "+
        money(amount)+
        " from the bank.",
        false
    );

    showToast(
        "🏦 Borrowed "+money(amount)
    );

    render();

}


function repay(amount){

    const payment=
        Math.min(
            amount,
            game.debt
        );

    if(
        payment<=0||
        payment>game.cash
    ){

        lossSound();

        showToast(
            "❌ You can't make that payment."
        );

        return;
    }

    game.cash-=payment;
    game.debt-=payment;

    debtSound();

    addNews(
        "💳 You repaid "+
        money(payment)+
        " of your debt.",
        false
    );

    render();

}


/* =====================================================
   SAVE / LOAD
===================================================== */

function saveSilent(){

    localStorage.setItem(
        "EMPIRE_LIFE_V10",
        JSON.stringify(game)
    );

}


function saveGame(){

    saveSilent();

    achievementSound();

    showToast(
        "💾 Game saved!"
    );

}


function loadGame(){

    const saved=
        localStorage.getItem(
            "EMPIRE_LIFE_V10"
        );

    if(!saved){

        showToast(
            "❌ No save found."
        );

        return;
    }

    try{

        game=JSON.parse(saved);

        achievementSound();

        showToast(
            "📂 Game loaded!"
        );

        render();

    }catch(e){

        showToast(
            "❌ Save could not be loaded."
        );

    }

}


